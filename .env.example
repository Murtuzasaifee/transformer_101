# Training-run controls, loaded automatically by scripts/train.py (via
# config.load_config). Copy this file to `.env` and adjust as needed.
# Anything left unset here falls back to configs/multi30k.yaml.
#
# Model architecture (n_layers, d_model, etc.) is intentionally NOT here --
# that stays in the YAML config, since changing it changes what model you're
# training, not just how you're training it.

# Number of passes over the training data.
NUM_EPOCHS=8

# Per-step batch size (split evenly across GPUs when DISTRIBUTED=true).
BATCH_SIZE=32

# Gradient accumulation: number of batches whose gradients are summed before
# each optimizer step. Effective batch size = BATCH_SIZE * ACCUM_ITER.
ACCUM_ITER=10

# Peak learning-rate scale factor for the Noam (warmup + inverse-sqrt decay) schedule.
BASE_LR=1.0

# Number of warmup steps before the learning rate starts decaying.
WARMUP=3000

# Save a checkpoint every N epochs (a final checkpoint is always saved at the end).
CHECKPOINT_EVERY_N_EPOCHS=10

# Train across all visible GPUs with DistributedDataParallel.
DISTRIBUTED=false
